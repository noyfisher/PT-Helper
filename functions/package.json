{
  "name": "pt-helper-functions",
  "private": true,
  "scripts": {
    "prebuild": "ts-node scripts/build_catalog.ts",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "lint": "eslint src",
    "setup-agent": "ts-node scripts/setup-managed-agent.ts",
    "setup-form-agent": "ts-node scripts/setup-form-agent.ts",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore --config ../firebase.json --project demo-coil \"jest --config jest.rules.config.js\"",
    "test:integration": "firebase emulators:exec --only firestore --config ../firebase.json --project demo-coil \"jest --config jest.integration.config.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/billing": "^5.1.1",
    "@sendgrid/mail": "^8.1.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0"
  }
}
