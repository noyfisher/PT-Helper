default_platform(:ios)

# App Store Connect API identifiers come from the environment (CI secrets).
# They were previously committed as literal fallbacks; on a public repository
# that pre-stages two of the three components of ASC API auth for anyone
# browsing. Apple treats Key ID and Issuer ID as non-secret identifiers and the
# actual AuthKey .p8 is gitignored and has never been committed, so this is
# defense-in-depth — NOT a credential leak, and no rotation is warranted.
def require_env!(name)
  value = ENV[name]
  UI.user_error!("#{name} must be set (App Store Connect API identifier).") if value.nil? || value.empty?
  value
end

platform :ios do
  desc "Run smoke tests"
  lane :test do
    scan(
      project: "COIL.xcodeproj",
      scheme: "COIL",
      device: ENV["TEST_DEVICE"] || "iPhone 16",
      testplan: "SmokePlan",
      output_types: "junit",
      result_bundle: true,
      clean: true
    )
  end

  desc "Build IPA for App Store / TestFlight"
  lane :build do
    key_id = require_env!("ASC_KEY_ID")
    issuer_id = require_env!("ASC_ISSUER_ID")
    key_path = File.expand_path("../fastlane/AuthKey.p8", __dir__)

    increment_build_number(
      xcodeproj: "COIL.xcodeproj"
    )

    build_app(
      project: "COIL.xcodeproj",
      scheme: "COIL",
      output_directory: "./build",
      clean: true,
      export_options: "./fastlane/ExportOptions.plist",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{key_path}' -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    key_id = require_env!("ASC_KEY_ID")
    issuer_id = require_env!("ASC_ISSUER_ID")

    build

    if ENV["ASC_KEY_CONTENT"]
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true
      )
    else
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: "./fastlane/AuthKey.p8"
      )
    end

    changelog = changelog_from_git_commits(
      commits_count: 10,
      pretty: "- %s",
      merge_commit_filtering: "exclude_merges"
    )

    upload_to_testflight(
      api_key: api_key,
      changelog: changelog,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit to App Store (placeholder)"
  lane :release do
    UI.message("App Store release lane — not yet configured")
  end
end
