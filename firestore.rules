rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ----------------------------------------------------------------------
    // User health data.
    //
    // NOTE on Firestore rule semantics: grants are ADDITIVE (OR) across every
    // matching `match` block, and the recursive `{document=**}` matches nested
    // paths too. So this broad rule grants READ ONLY — if it also granted
    // `write`, the schema-bounded per-collection write rules below would be
    // bypassed (the broad grant would OR to true). Writes are therefore
    // enumerated per-subcollection. Any user subcollection NOT listed below is
    // read-only to clients (Admin-SDK/Cloud-Function writes still bypass rules).
    // ----------------------------------------------------------------------
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId);
    }

    // Schema-bounded: formAnalyses is consumed by the cross-session form agent
    // as ground truth, so a forged score/name would poison AI feedback.
    match /users/{userId}/formAnalyses/{doc} {
      allow create, update: if isOwner(userId)
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.exerciseName is string
        && request.resource.data.exerciseName.size() <= 200
        && request.resource.data.createdAt is timestamp;
      allow delete: if isOwner(userId);
    }

    // Schema-bounded: streakData feeds achievements/analytics.
    match /users/{userId}/streakData/{doc} {
      allow create, update: if isOwner(userId)
        && request.resource.data.currentStreak is int
        && request.resource.data.currentStreak >= 0
        && request.resource.data.currentStreak <= 100000
        && request.resource.data.longestStreak is int
        && request.resource.data.longestStreak >= 0
        && request.resource.data.longestStreak <= 100000;
      allow delete: if isOwner(userId);
    }

    // Remaining client-written user subcollections (no schema bound today;
    // owner-scoped write preserves existing behavior). Keep this list in sync
    // with the iOS write paths.
    match /users/{userId}/profile/{doc}          { allow write: if isOwner(userId); }
    match /users/{userId}/rehabPlans/{doc}        { allow write: if isOwner(userId); }
    match /users/{userId}/workoutSessions/{doc}   { allow write: if isOwner(userId); }
    match /users/{userId}/assessments/{doc}       { allow write: if isOwner(userId); }
    match /users/{userId}/notes/{doc}             { allow write: if isOwner(userId); }
    match /users/{userId}/wellnessPlans/{doc}     { allow write: if isOwner(userId); }
    match /users/{userId}/analysisOutcomes/{doc}  { allow write: if isOwner(userId); }
    // Consents — owner-writable, but `dateOfBirth` is immutable once set (age-gate
    // integrity, P1-04/P2-02): it can be set once, re-written with the SAME value
    // (merge writes preserve it), but never changed or cleared to forge an age.
    match /users/{userId}/consents/{doc} {
      allow write: if isOwner(userId)
        && (resource == null
            || !('dateOfBirth' in resource.data)
            || request.resource.data.dateOfBirth == resource.data.dateOfBirth);
    }
    match /users/{userId}/riskAcknowledgements/{doc} { allow write: if isOwner(userId); }

    // Missing exercise images — telemetry of unmatched exercise images. No PII.
    // Authenticated read is preserved (the in-app debug view reads it); writes
    // are constrained so any user cannot rewrite arbitrary fields or jump the
    // shared counter (client increments by exactly 1 via FieldValue.increment).
    // Backlog of exercises with no bundled illustration. No PII (exercise names and
    // a counter), and the debug view reads it, so authenticated read stays.
    //
    // Writes are bounded to the exact field set the client sends. The previous rule
    // checked only that `exerciseName` was a string, which allowed two things it
    // should not have: unbounded junk documents under attacker-chosen ids, and —
    // more seriously — forging the fields `generateExerciseImage` uses as its
    // DISTRIBUTED LOCK. A client could write status:"generating" with a fresh
    // timestamp and block image generation for that exercise for the lock's TTL,
    // renewing it indefinitely. `status` and `generatingStartedAt` are Admin-SDK
    // only and are absent from `hasOnly` below, so a client write carrying them is
    // rejected outright. Mirrors the concernReports pattern above.
    match /missingExerciseImages/{docId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'exerciseName', 'normalizedKey', 'matchType', 'exerciseCategory',
             'targetArea', 'source', 'count', 'lastSeen', 'matchedTo', 'substitutedTo'
           ])
        && request.resource.data.exerciseName is string
        && request.resource.data.exerciseName.size() > 0
        && request.resource.data.exerciseName.size() <= 200
        && request.resource.data.normalizedKey is string
        && request.resource.data.normalizedKey.size() <= 200
        && request.resource.data.matchType is string
        && request.resource.data.matchType.size() <= 50
        && request.resource.data.exerciseCategory is string
        && request.resource.data.exerciseCategory.size() <= 100
        && request.resource.data.targetArea is string
        && request.resource.data.targetArea.size() <= 100
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 50
        // Counter may only ever step by one, on create or update.
        && request.resource.data.count is int
        && (resource == null
            ? request.resource.data.count == 1
            : request.resource.data.count == resource.data.count + 1);
    }

    // Session logs — append-only crash/session telemetry. Owner-scoped read;
    // create only (no client update/delete — let TTL/admin handle cleanup).
    match /sessionLogs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Concern reports — user-submitted safety/moderation reports. Create-only;
    // only the Admin SDK reads these. Field-bounded (P2-02): a client can only
    // write these exact keys, with a non-empty bounded message + bounded category,
    // so a report doc can't be used to smuggle arbitrary/oversized data.
    match /concernReports/{doc} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'category', 'message', 'createdAt', 'appVersion'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt is timestamp;
    }

    // Remote config (e.g. config/exerciseImageAliases) — readable by any signed-in
    // client (production hot-fix lever); only Admin SDK writes.
    match /config/{doc} {
      // Scoped to the ONE document the client actually reads (verified: the alias
      // hot-fix lever in ExerciseImageService). The same collection also holds
      // operational counters — config/aiDailyBudget and config/imageGenBudget —
      // and a blanket read let any signed-in user watch the global AI spend and
      // see when the daily ceiling was exhausted, which is useful for timing abuse.
      allow read: if request.auth != null && doc == 'exerciseImageAliases';
      allow write: if false;
    }

    // Validation-shadow telemetry (low-value debug counters written by the
    // iOS validation pipeline). Constrained to authenticated writes so the
    // existing writes succeed without opening arbitrary cross-user reads.
    // Bounded like concernReports: these are write-only debug telemetry, so an
    // unbounded `create` was an open door for storage/write-cost inflation under
    // attacker-chosen document ids.
    match /comorbidityAliasMisses/{doc} {
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count', 'lastOriginal', 'lastAt'])
        && request.resource.data.lastOriginal is string
        && request.resource.data.lastOriginal.size() <= 200;
    }
    match /unknownRepSpecs/{doc}          { allow create, update: if request.auth != null; }
    match /strictParseWouldReject/{doc}   { allow create, update: if request.auth != null; }

    // Rate-limit counters (Tier 2 PR B). Only the Cloud Function Admin SDK
    // touches these — clients must NEVER be able to decrement or delete them
    // to sidestep the 20/min limit. Explicit deny for clarity; the default
    // would also be deny, but this prevents a future refactor from leaving
    // the path open.
    match /rateLimits/{uid}/windows/{windowKey} {
      allow read, write: if false;
    }
  }
}
